<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.jenkins-ci.plugins</groupId>
    <artifactId>plugin</artifactId>
    <version>6.2211.v27f680c93c53</version>
    <relativePath />
  </parent>

  <groupId>io.github.rads4</groupId>
  <artifactId>ck-aws</artifactId>
  <version>${revision}${changelist}</version>
  <packaging>hpi</packaging>

  <name>CK AWS Plugin</name>
  <description>Centralizes AWS authentication and generic AWS CLI execution for Jenkins deployment pipelines.</description>

  <properties>
    <revision>1.0</revision>
    <changelist>-SNAPSHOT</changelist>
    <!--
      Baseline is pinned to CloudKeeper's actual Jenkins version (2.479.2) rather than the
      current recommended LTS, so the plugin is guaranteed loadable on CK's real instance.
      Note this is deliberately BELOW the archetype default (2.528.3) and below the update
      center distribution floor (~2.504.2) - acceptable because the POC is never published.
      https://www.jenkins.io/doc/developer/plugin-development/choosing-jenkins-baseline/
    -->
    <jenkins.baseline>2.479</jenkins.baseline>
    <jenkins.version>${jenkins.baseline}.2</jenkins.version>

    <spotless.check.skip>false</spotless.check.skip>
    <ban-junit4-imports.skip>false</ban-junit4-imports.skip>
    <ban-commons-lang-2.skip>false</ban-commons-lang-2.skip>
    <hpi.strictBundledArtifacts>true</hpi.strictBundledArtifacts>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.jenkins.tools.bom</groupId>
        <artifactId>bom-${jenkins.baseline}.x</artifactId>
        <version>5054.v620b_5d2b_d5e6</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <repositories>
    <repository>
      <id>repo.jenkins-ci.org</id>
      <url>https://repo.jenkins-ci.org/public/</url>
    </repository>
  </repositories>
  <pluginRepositories>
    <pluginRepository>
      <id>repo.jenkins-ci.org</id>
      <url>https://repo.jenkins-ci.org/public/</url>
    </pluginRepository>
  </pluginRepositories>
</project>
