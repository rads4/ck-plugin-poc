<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.jenkins-ci.plugins</groupId>
    <artifactId>plugin</artifactId>
    <version>6.2211.v27f680c93c53</version>
    <relativePath />
  </parent>

  <groupId>io.github.rads4</groupId>
  <artifactId>ck-aws</artifactId>
  <version>${revision}${changelist}</version>
  <packaging>hpi</packaging>

  <name>CK AWS Plugin</name>
  <description>Centralizes AWS authentication and generic AWS CLI execution for Jenkins deployment pipelines.</description>

  <properties>
    <revision>1.0</revision>
    <changelist>-SNAPSHOT</changelist>
    <!--
      Baseline is pinned to CloudKeeper's actual Jenkins version (2.479.2) rather than the
      current recommended LTS, so the plugin is guaranteed loadable on CK's real instance.
      Note this is deliberately BELOW the archetype default (2.528.3) and below the update
      center distribution floor (~2.504.2) - acceptable because the POC is never published.
      https://www.jenkins.io/doc/developer/plugin-development/choosing-jenkins-baseline/
    -->
    <jenkins.baseline>2.479</jenkins.baseline>
    <jenkins.version>${jenkins.baseline}.2</jenkins.version>

    <spotless.check.skip>false</spotless.check.skip>
    <ban-junit4-imports.skip>false</ban-junit4-imports.skip>
    <ban-commons-lang-2.skip>false</ban-commons-lang-2.skip>
    <hpi.strictBundledArtifacts>true</hpi.strictBundledArtifacts>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.jenkins.tools.bom</groupId>
        <artifactId>bom-${jenkins.baseline}.x</artifactId>
        <!--
          Pinned deliberately, NOT to the newest BOM release. Every BOM after this one pins
          workflow-cps >= 4050, whose manifest requires Jenkins 2.479.3 - which would force the
          jenkins.version baseline above CK production (2.479.2) and break the M0 guarantee that the
          plugin is loadable on CK's real instance. 4488 is the newest tested-together set whose
          workflow-cps (4046.v90b_1b_9edec67) still requires only 2.479.1.
          Revisit once CK moves to 2.479.3+.
        -->
        <version>4488.v7fe26526366e</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!--
      Pipeline step API only: Step / StepDescriptor / StepExecution. Versions are managed by the
      Jenkins plugin BOM above, so none are pinned here.
    -->
    <dependency>
      <groupId>org.jenkins-ci.plugins.workflow</groupId>
      <artifactId>workflow-step-api</artifactId>
    </dependency>
    <!--
      Test-only: the minimum needed to define and run a Pipeline job in JenkinsRule tests. Deliberately
      NOT workflow-basic-steps or workflow-durable-task-step - the step needs no 'node' block, and tests
      assert the step's return value with plain Groovy rather than 'echo', which keeps the dependency
      set small enough to stay within the 2.479.2 baseline (see the BOM comment above).
    -->
    <dependency>
      <groupId>org.jenkins-ci.plugins.workflow</groupId>
      <artifactId>workflow-cps</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jenkins-ci.plugins.workflow</groupId>
      <artifactId>workflow-job</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <repositories>
    <repository>
      <id>repo.jenkins-ci.org</id>
      <url>https://repo.jenkins-ci.org/public/</url>
    </repository>
  </repositories>
  <pluginRepositories>
    <pluginRepository>
      <id>repo.jenkins-ci.org</id>
      <url>https://repo.jenkins-ci.org/public/</url>
    </pluginRepository>
  </pluginRepositories>
</project>
